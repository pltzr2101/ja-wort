# Gemeinsames Passwort fuer Gaeste (Freunde & Familie).
# Nur noetig, wenn das Gaeste-Gate aktiv ist (GUEST_GATE_ENABLED=true).
# Bei deaktiviertem Gate darf der Wert leer bleiben.
GUEST_PASSWORD=change-me-guest

# Gaeste-Gate: Passwort vor der Website aktivieren ("true", Standard) oder
# deaktivieren ("false"). Bei "false" ist die Website ohne Passwort erreichbar;
# der Admin-Bereich bleibt davon unberuehrt und weiterhin passwortgeschuetzt.
GUEST_GATE_ENABLED=true

# Admin-Passwort fuer den geschuetzten Verwaltungsbereich. Pflicht.
ADMIN_PASSWORD=change-me-admin

# Optional: Geheimschluessel zum Signieren der Login-Cookies.
# Wenn leer, wird beim ersten Start automatisch einer erzeugt und unter
# ./data/session-secret gespeichert (bleibt bei Neustarts erhalten).
SESSION_SECRET=

# Hinweis zur Anmeldung:
# - Gast-Sessions (Familie & Freunde) bleiben 7 Tage gueltig.
# - Admin-Sessions bleiben 24 Stunden gueltig.
# - Wird das jeweilige Passwort (GUEST_PASSWORD / ADMIN_PASSWORD) geaendert,
#   werden alle bestehenden Sessions sofort ungueltig.

# Optional: Host-Port fuer den Docker-Container. Nicht mit dem internen
# Container-Port (3000) verwechseln. Default: 8095.
APP_PORT=8095
